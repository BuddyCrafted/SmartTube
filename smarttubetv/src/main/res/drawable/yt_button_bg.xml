<?xml version="1.0" encoding="utf-8"?>
<!-- WiiOS: YouTube-style round player button, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/yt_button_bg_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/yt_button_bg" />
        </shape>
    </item>
</selector>
